{
	"name": "supernovae-tab",
	"version": "1.2.0",
	"description": "A galaxy-themed new tab — animated starfield, space aesthetics, and your vault at the center of the universe.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"dev:mobile": "node esbuild.config.mjs --mobile",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [],
	"author": "Zoléni KOKOLO ZASSI",
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^16.11.6",
		"@types/react": "^18.2.42",
		"@types/react-dom": "^18.2.17",
		"@typescript-eslint/eslint-plugin": "5.29.0",
		"@typescript-eslint/parser": "5.29.0",
		"esbuild": "^0.28.2",
		"esbuild-sass-plugin": "^3.7.0",
		"obsidian": "^1.13.1",
		"tslib": "2.4.0",
		"typescript": "4.7.4"
	},
	"dependencies": {
		"esbuild-copy-static-files": "^0.1.0",
		"react": "^18.2.0",
		"react-dom": "^18.2.0"
	}
}
